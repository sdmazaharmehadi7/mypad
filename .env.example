# MongoDB Connection String (Server-side only — NEVER prefix with NEXT_PUBLIC_)
# Add your MongoDB connection string in .env.local (which is git-ignored)
# Example for local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/mypad
#
# Example for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/mypad

# Public Site URL for SEO canonical metadata and OpenGraph (optional, defaults to https://mypad-org.vercel.app)
NEXT_PUBLIC_SITE_URL=https://mypad-org.vercel.app
